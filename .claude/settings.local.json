{
  "permissions": {
    "allow": [
      "Bash(pip install:*)",
      "Bash(powershell.exe:*)",
      "Bash(python test_clap.py)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".claude/hooks/auto-commit.sh\" 2>/dev/null || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
